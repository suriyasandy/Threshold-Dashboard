import os
import sys
from pathlib import Path
from dotenv import load_dotenv

# Locate the folder containing the EXE (or launcher.py when running from source)
if getattr(sys, "frozen", False):
    base_dir = Path(sys.executable).parent
else:
    base_dir = Path(__file__).resolve().parent

# Load .env
env_file = base_dir / ".env"
load_dotenv(env_file)

print("Using .env:", env_file)
print("APP_NAME:", os.getenv("APP_NAME"))

import threading
import time
import webbrowser
import uvicorn

# Import AFTER loading .env
import app.modules.data_fetch
import app.modules.exception_analysis
import app.modules.audit_sampling
import app.modules.threshold_analysis

from app.main import app as fastapi_app

def run_server():
    uvicorn.run(fastapi_app, host="127.0.0.1", port=8000, log_level="error")

if __name__ == "__main__":
    t = threading.Thread(target=run_server, daemon=True)
    t.start()
    time.sleep(1.5)
    webbrowser.open("http://127.0.0.1:8000")
    t.join()
